### LLaMA-Factory {{ llamafactory_version }} - SFT of the style model ({{ profile.name }}, {{ profile.gpu }})
### rendered by twin.training.yaml_render; do not edit by hand

### model
model_name_or_path: {{ model_path }}
trust_remote_code: false
flash_attn: sdpa
{% if profile.quantization_bit %}
quantization_bit: {{ profile.quantization_bit }}
quantization_method: bnb
{% endif %}

### method
stage: sft
do_train: true
finetuning_type: lora
lora_rank: {{ profile.lora_rank }}
lora_alpha: {{ profile.lora_alpha }}
lora_target: all

### dataset
dataset: {{ dataset_train }}
eval_dataset: {{ dataset_val }}
dataset_dir: {{ data_dir }}
template: {{ template }}
cutoff_len: {{ cutoff_len }}
mask_history: true
preprocessing_num_workers: 8
dataloader_num_workers: 2
seed: 42

### output
output_dir: {{ output_dir }}/sft
logging_steps: {{ plan.logging_steps }}
save_steps: {{ plan.eval_steps }}
save_total_limit: 3
save_only_model: false
plot_loss: true
overwrite_output_dir: false
report_to: none
resume_from_checkpoint: null

### train
per_device_train_batch_size: {{ profile.per_device_train_batch_size }}
gradient_accumulation_steps: {{ profile.gradient_accumulation_steps }}
learning_rate: {{ learning_rate }}
num_train_epochs: {{ epochs }}.0
lr_scheduler_type: cosine
warmup_ratio: {{ warmup_ratio }}
bf16: true
gradient_checkpointing: true
ddp_timeout: 180000000

### eval
per_device_eval_batch_size: {{ profile.per_device_train_batch_size }}
eval_strategy: steps
eval_steps: {{ plan.eval_steps }}
load_best_model_at_end: true
metric_for_best_model: eval_loss
greater_is_better: false
early_stopping_steps: {{ patience }}
