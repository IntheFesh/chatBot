### LLaMA-Factory {{ llamafactory_version }} - merge the LoRA adapter into the bf16 base ({{ profile.name }})
### rendered by twin.training.yaml_render; do not edit by hand
### The base is always loaded unquantised: an adapter trained on a 4-bit base can only be merged
### into the bf16 weights, and LLaMA-Factory refuses to merge into a quantised model.
### export.sh points adapter_name_or_path at the best adapter (output/dpo when it exists).

### model (no quantization_bit here)
model_name_or_path: {{ model_path }}
adapter_name_or_path: {{ output_dir }}/sft
template: {{ template }}
trust_remote_code: false
finetuning_type: lora

### export
export_dir: {{ output_dir }}/merged
export_size: 5
export_device: {{ profile.export_device }}
export_legacy_format: false
